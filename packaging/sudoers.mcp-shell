# /etc/sudoers.d/mcp-shell — mode 0440
# Vérifier avant usage : visudo -cf /etc/sudoers.d/mcp-shell
#
# Une entrée par commande, arguments figés ou expression régulière ancrée.
# Doit refléter [exec].allow de /etc/mcp-shell/config.toml.
#
# Ne PAS utiliser les jokers sudoers (`*`) dans les arguments : `*` accepte aussi
# les espaces, donc des arguments supplémentaires (`pct start 100 --skiplock`).
# Utiliser à la place une regex ^…$ (sudo >= 1.9.10 : Debian 12 / Proxmox 8,
# Alpine 3.16+). Une entrée sans argument (`/usr/sbin/pct list`) n'accepte que
# ces arguments exacts.
Cmnd_Alias MCP_READ = /usr/sbin/pct list, /usr/sbin/pct ^config [0-9]+$, \
                      /usr/sbin/qm list, /usr/sbin/qm ^config [0-9]+$, \
                      /usr/sbin/pvesm status, \
                      /usr/sbin/zpool status, /usr/sbin/zpool status -x, /usr/sbin/zpool list, \
                      /usr/sbin/zfs list, /usr/sbin/zfs list -t snapshot, \
                      /usr/sbin/smartctl ^-H /dev/(sd[a-z]|nvme[0-9]n[0-9])$
mcp-shell ALL=(root) NOPASSWD: MCP_READ
