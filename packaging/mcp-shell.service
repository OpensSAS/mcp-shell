[Unit]
Description=mcp-shell - serveur MCP d'exécution shell sous liste blanche
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp-shell
Group=mcp-shell
ExecStart=/usr/local/bin/mcp-shell serve -c /etc/mcp-shell/config.toml
Restart=on-failure
RestartSec=5
# Permet d'écouter sur un port < 1024 sans root si besoin
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=false
ProtectHome=read-only
PrivateTmp=true
LogsDirectory=mcp-shell

[Install]
WantedBy=multi-user.target
